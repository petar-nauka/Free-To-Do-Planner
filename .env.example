# Copy to `.env` (next to docker-compose.yml) before `docker compose up -d --build`.
# These values are baked into the frontend at BUILD time — after changing them, rebuild.

# Your Supabase project URL, e.g. https://abcd1234.supabase.co or https://supabase.your-domain.com
VITE_SUPABASE_URL=

# The public "anon" / "publishable" key. NEVER the service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Host port the app listens on (bound to 127.0.0.1 — put a reverse proxy with HTTPS in front).
APP_PORT=8100
