# Copy to `backend/.env`. The backend is OPTIONAL: it only sends e-mails
# (reminders every 5 min, overdue tasks at 08:00, weekly report at 08:05, Europe/Sofia time).
# The web app works without it — the frontend talks to Supabase directly.

# --- Required to start (legacy demo endpoints). No MongoDB server is needed;
# --- leave these placeholder values as they are.
MONGO_URL=mongodb://localhost:27017
DB_NAME=todo_app

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=
# service_role key: the backend reads all users' reminders. Keep it secret, server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Fallback if the service_role key is empty (limited by RLS):
SUPABASE_ANON_KEY=

# --- Optional ---
# Comma-separated origins allowed to call the backend API (default '*').
CORS_ORIGINS=
RATE_LIMIT_DEFAULT=120/minute

# NOTE: e-mail gateway settings are NOT here. An admin sets them in the app
# (Settings → E-mail); they are stored in the Supabase table `app_settings`.
