# Copy to `frontend/.env` for local development (`npm run dev`).
# Both values are required — without them the app will not start.

# Your Supabase project URL (Project Settings → API), e.g. https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# The public "anon" / "publishable" key (Project Settings → API). NEVER the service_role key.
# Note: the variable is named PUBLISHABLE_KEY, not ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional, only for a SELF-HOSTED Supabase that accepts requests from your production
# origin only. Put these two lines in `frontend/.env.development.local` instead:
#   DEV_SUPABASE_PROXY_TARGET=https://supabase.your-domain.com
#   VITE_SUPABASE_URL=http://localhost:3000
# The Vite dev server then proxies /rest, /auth, /storage, /functions and /realtime.
